{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vide",
  "mainBinaryName": "vide",
  "version": "0.1.0",
  "identifier": "com.vector.ide",
  "build": {
    "frontendDist": "../dist/Vector-ide/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vector IDE",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Vector IDE",
    "longDescription": "Vector IDE - Modern Lightweight Development Environment",
    "targets": "all",
    "resources": [
      "bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "desktopTemplate": "desktop.template"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
