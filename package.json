{
  "name": "vector-ide",
  "version": "0.4.13",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "prettier": {
    "useTabs": true,
    "tabWidth": 4,
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "description": "A fast, zero-bloat desktop IDE built with Tauri v2, Rust, and Angular",
  "author": "Ori Kuttner <ori@heliconbooks.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/OriKuttner/vide.git"
  },
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@prettier/plugin-php": "^0.26.0",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tauri-apps/cli": "^2.12.3",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
